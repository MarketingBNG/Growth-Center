# ── Required ──────────────────────────────────────────────────────────────────

# Neon Postgres. Use the POOLED connection string (…-pooler.…) for the app.
# sslmode=verify-full explicitly: pg treats "require" as an alias for it today but warns
# that a future major version will weaken it to libpq semantics.
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=verify-full"

# The same database WITHOUT the -pooler suffix, used only by `prisma migrate`.
# Migrations take a session-level advisory lock; pgbouncer pools at transaction level, so
# run through the pooler the lock is stranded on an idle connection and every later deploy
# fails with P1002 ("Timed out trying to acquire a postgres advisory lock").
DIRECT_URL="postgresql://user:pass@host.region.aws.neon.tech/db?sslmode=verify-full"

# Sign-in. Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth for sign-in. Authorised redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Encrypts integration credentials at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32   → must be exactly 64 hex characters.
APP_ENCRYPTION_KEY=""

# ── Optional: integrations ────────────────────────────────────────────────────
# Every integration below reads "not connected — requires API credentials" in the
# Integration Center until its variables are filled in. Nothing breaks without them.

# Meta (Facebook + Instagram Ads)
META_APP_ID=""
META_APP_SECRET=""

# Semrush (SEO) needs no variable here — its key is pasted into the Integration Center
# and stored encrypted, like any other API-key provider.

# Zoho CRM — matches the pattern already used by bng-command-center
# Register at api-console.zoho.in (note .in — see ZOHO_DC below).
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""

# Zoho data centre suffix. BNG's account is on India, which is the default; use "com",
# "eu", "au" or "jp" only if your Zoho account was created in that region. Getting this
# wrong fails authentication outright — the regions do not share accounts.
ZOHO_DC="in"

# ── Scheduled syncs ───────────────────────────────────────────────────────────
# Authenticates Vercel's nightly call to /api/cron/sync. Generate with:
#   openssl rand -hex 32
# Unset, the endpoint answers 503 and nothing syncs automatically — it never runs
# unauthenticated, or a forgotten variable would leave a public endpoint that hammers
# every connected provider on demand.
CRON_SECRET=""

# ── Optional: AI insights ─────────────────────────────────────────────────────
# Without this the AI Insights page says so explicitly and shows seeded examples
# labelled as samples. It never claims analysis that did not run.
ANTHROPIC_API_KEY=""

# ── Optional: outreach email ──────────────────────────────────────────────────
# Unset, outreach sends through the console provider (logs, sends nothing).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# ── Zoho Cliq ─────────────────────────────────────────────────────────────────
# Optional, and independent of SMTP. The digest posts to chat as well as mail, so a
# refused mailbox does not mean the findings reach nobody.
# Cliq → the channel → Integrations → Incoming Webhooks → create, then paste the whole
# URL including its token.
CLIQ_WEBHOOK_URL=

# ── Zoho Projects ─────────────────────────────────────────────────────────────
# Its OWN OAuth client, never the CRM's: Zoho fixes scope at authorisation, so adding
# Projects scopes to ZOHO_CLIENT_ID would force a CRM reconnect and revoke production's
# refresh token.
ZOHO_PROJECTS_CLIENT_ID=
ZOHO_PROJECTS_CLIENT_SECRET=

# ── Google Ads ────────────────────────────────────────────────────────────────
# Reuses GOOGLE_CLIENT_ID. The developer token is separate, comes from the manager
# account's API Center, and starts with Test Account access only — Basic access is a form
# Google reviews by hand.
GOOGLE_ADS_DEVELOPER_TOKEN=

# ── LinkedIn Ads ──────────────────────────────────────────────────────────────
# Needs the Marketing Developer Platform product approved on the LinkedIn app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
