// Growth Center — schema.
//
// Single-tenant on purpose: this is BNG's own marketing team's tool, so there is no
// organizationId anywhere. Access control is the roster in lib/roles.ts, the same
// mechanism bng-command-center uses. If BNG ever runs growth for client companies,
// that becomes a migration, not a rewrite.
//
// Two decisions carry most of the weight here:
//
//   Activity is append-only. Lead status lives on Lead for querying, but every
//   change also writes an Activity row, so "how did this lead get here" is answerable
//   from the table rather than lost to the last UPDATE.
//
//   MetricSnapshot is the only time-series table. Every integration writes into it
//   and every chart reads from it, so adding a provider adds rows, not tables.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Prisma 7 no longer accepts `url` here — the CLI reads it from prisma.config.ts and
// the runtime client builds its own in lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

// ─── enums ────────────────────────────────────────────────────────────────────

/// Mirrors lib/roles.ts. Three tiers, widest first: an owner can do everything including
/// settings, keys and approvals; an admin runs the day to day but cannot approve or reach
/// settings; a user works on records and content.
enum Role {
  owner
  admin
  user
}

enum LeadStatus {
  new
  contacted
  /// This org's own first bar, and most of its worked pipeline: a lead that has passed
  /// an initial screen but has not been fully qualified. It used to be folded into
  /// `qualified` by a substring match, which made 2,480 of 2,490 "qualified" leads
  /// semi-qualified ones. Its own stage so the funnel says which is which.
  semi_qualified
  qualified
  unqualified
  converted
  lost
}

enum SourceType {
  website
  landing_page
  form
  paid_ads
  organic_search
  social
  referral
  outreach
  event
  import
  manual
}

enum ActivityType {
  created
  status_changed
  owner_changed
  note_added
  email
  call
  meeting
  task_completed
  stage_changed
  converted
  synced
}

enum TaskStatus {
  open
  in_progress
  done
  cancelled
}

enum Priority {
  low
  normal
  high
  urgent
}

/// §15.3: "Statuses, enforced in order: Idea -> Brief -> Draft -> Technical check ->
/// Proofread and brand -> Partner approval -> Scheduled -> Published -> Repurposed."
///
/// Nine, where there were six. The three that were missing are the three the manual
/// cares about most: the technical check and the proofread are two separate recorded
/// steps rather than one habit called "review", and `repurposed` is what marks an item
/// as having produced children.
///
/// `archived` is kept and is not part of the order. It is where an item goes when it is
/// abandoned, which is not a stage of production — a workflow with no exit forces people
/// to publish things to get them off the board.
enum ContentStatus {
  idea
  brief
  draft
  technical_check
  proofread
  partner_approval
  scheduled
  published
  repurposed
  archived
}

/// The five states an integration card may render. Never inferred — always read from
/// the Integration row, so nothing shows "connected" without a credential.
enum IntegrationState {
  disconnected
  connecting
  connected
  syncing
  error
  demo_data
}

enum SocialNetwork {
  instagram
  facebook
  linkedin
  x
  youtube
  tiktok
}

enum ProspectStatus {
  pending
  active
  replied
  bounced
  unsubscribed
  completed
}

enum InsightKind {
  opportunity
  risk
  anomaly
  recommendation
}

// ─── marketing structure ──────────────────────────────────────────────────────

/// A route to market: "Google Ads", "Organic Search", "LinkedIn". Deliberately a table
/// rather than an enum so the team can add one without a migration.
model Channel {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique
  kind String @default("other") // paid | organic | social | email | referral | direct | other

  campaigns Campaign[]
  leads     Lead[]
  revenue   RevenueEntry[]
  opportunities Opportunity[]
  envelopes BudgetEnvelope[]

  createdAt DateTime @default(now())

  @@map("channel")
}

model Campaign {
  id        String    @id @default(cuid())
  name      String
  channelId String
  status    String    @default("active") // active | paused | completed | draft
  startDate DateTime?
  endDate   DateTime?

  /// Planned budget. Actual money out is the sum of MarketingSpend rows, which is what
  /// every ROAS/CAC figure uses — a budget is an intention, not a cost.
  budget Decimal? @db.Decimal(14, 2)

  /// The currency the budget is stated in — the ad account's, not the workspace's.
  currency String @default("USD")

  /// Whether `budget` is a per-day allowance or one for the campaign's whole run.
  /// "daily" | "lifetime", null when the provider did not say.
  ///
  /// Meta reports one or the other and never both, and the two were collapsed into a
  /// single column. Pacing then divided a month of spend by a single day's budget and
  /// reported 906.9% — the arithmetic was right and the units were not.
  budgetPeriod String?

  /// The provider's own id for this campaign, when it came from one. Lets a sync
  /// update in place instead of duplicating.
  externalId String?
  source     String? // integration id: meta_ads, google_analytics, …

  /// What the money was trying to buy: acquisition | hiring | awareness | other.
  ///
  /// G4. Recruitment advertising runs out of the same ad account as lead generation here,
  /// and every rupee of it was in the denominator of CPL, CPQL, CAC and ROAS — ₹67,108,
  /// 15.6% of spend over the default window. Spend that was never asked to produce a
  /// client is not a cost of acquiring one.
  ///
  /// Resolved in lib/campaign-objective.ts from Meta's employment declaration, then the
  /// name, then the platform objective. Null means never classified, which
  /// `isAcquisition` counts as acquisition — an unknown must overstate cost, never
  /// understate it.
  objective String?

  /// The platform's own objective string, verbatim: OUTCOME_LEADS, BRAND_AWARENESS, …
  ///
  /// Kept beside the normalised value rather than discarded, so re-classifying later is a
  /// re-read of stored data instead of a re-sync of the ad platform.
  platformObjective String?

  /// Where the ads sent people. §10 asks for it as a column on the campaign table; a
  /// campaign whose landing page 404s spends its whole budget before anybody notices.
  landingPage String?

  notes String?

  channel       Channel         @relation(fields: [channelId], references: [id])
  spend         MarketingSpend[]
  leads         Lead[]
  opportunities Opportunity[]
  revenue       RevenueEntry[]
  content       ContentPiece[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([channelId])
  @@map("campaign")
}

/// One day of spend for one campaign. Daily granularity because that is what the ad
/// platforms report and what a date-range filter needs.
/// Workspace preferences, read as a block. JSON per key so adding a preference is not a
/// migration; the shapes are validated in lib/settings.ts where they are read.
model AppSetting {
  key   String @id
  value Json

  updatedAt DateTime @updatedAt

  @@map("app_setting")
}

/// What the firm intends to spend on a channel in a period. §22: Akshay "sets the budget
/// envelope by channel", once a quarter, "recorded with his identity".
///
/// Deliberately not Campaign.budget, which is the ad platform's own number imported by
/// the sync. That is what Meta was told to spend; this is what the firm decided to spend,
/// and the two answer different questions — budget pacing computed against the platform's
/// figure can only ever say whether the platform is doing as it was told.
model BudgetEnvelope {
  id        String @id @default(cuid())
  channelId String

  /// The period this covers, inclusive of the start and exclusive of the end, as
  /// "YYYY-MM-DD". A range rather than a quarter label so the same row shape holds a
  /// month, a quarter or a year.
  ///
  /// Strings, not DATE columns, and deliberately. As DATE these were written by Prisma
  /// from the JS Date's UTC parts and read back by node-postgres as midnight in the
  /// process's own timezone — so an envelope for Q3 2026 stored as 2026-06-30 in an IST
  /// process, and the two halves only agreed because both were wrong in the same
  /// direction. A row written in one timezone and read in another would not have matched
  /// at all, which is exactly what dev in IST and production in UTC would have done.
  ///
  /// A date-only value has no timezone. Stored as the text it is, it compares exactly,
  /// sorts correctly, and reads in the database as the day somebody actually chose.
  periodStart String
  periodEnd   String

  amount   Decimal @db.Decimal(14, 2)
  /// The currency the envelope was decided in. Spend arrives in whatever each platform
  /// bills, so a comparison converts — and an envelope stated in the wrong currency is
  /// out by the exchange rate while looking entirely plausible.
  currency String  @default("INR")

  /// Whose decision this was, and when. §22 asks for the identity on the record, and the
  /// reason is that an envelope is an instruction: someone has to own it.
  setByEmail String
  setAt      DateTime @default(now())

  note String?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One envelope per channel per period. A second would make "the envelope" ambiguous,
  /// and every figure derived from it would depend on which row was read first.
  @@unique([channelId, periodStart, periodEnd])
  @@index([periodStart, periodEnd])
  @@map("budget_envelope")
}

model MarketingSpend {
  id         String   @id @default(cuid())
  campaignId String
  date       DateTime @db.Date

  amount      Decimal @db.Decimal(14, 2)

  /// The currency the ad platform billed in, which is not necessarily the one the
  /// workspace reports in. Without it a rupee of spend was indistinguishable from a
  /// dollar of it.
  currency    String  @default("USD")
  impressions Int     @default(0)
  clicks      Int     @default(0)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([date])
  @@map("marketing_spend")
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

model Company {
  id       String  @id @default(cuid())
  name     String

  /// `name` reduced by normalizeCompanyName, so "Acme, Inc." and "acme inc" match. Not
  /// unique: two genuinely different accounts can normalise alike, and refusing the
  /// second would lose it.
  nameKey  String?
  domain   String? @unique
  industry String?
  size     String?
  country  String?
  website  String?
  phone    String?
  notes    String?

  /// Plain string array rather than a Tag table and two join tables. One caller, no
  /// tag metadata, and Postgres indexes arrays fine.
  tags String[] @default([])

  ownerEmail String?

  /// §8.4: "the dual-jurisdiction facts the delivery team already knows and marketing
  /// cannot target without."
  ///
  /// Free text against a documented vocabulary rather than enums, because these are
  /// entered by hand and an enum turns a new jurisdiction into a migration. The
  /// vocabularies live in lib/company-facts.ts, where the form reads them.
  ///
  /// Null everywhere until somebody fills them in. The manual's own "done when" is the
  /// top hundred accounts, not all 2,953 — this is knowledge the delivery team holds and
  /// nothing in Zoho carries, so there is nothing to import and nothing to infer.
  segment      String?
  entityType   String?
  jurisdictions String[] @default([])

  contacts      Contact[]
  leads         Lead[]
  opportunities Opportunity[]
  customer      Customer?
  activities    Activity[]
  noteEntries   Note[]
  tasks         Task[]


  /// The provider's own id for this record, when a sync imported it. Lets a re-sync
  /// update in place instead of duplicating — the pattern Campaign already uses.
  externalId String?
  source     String? // integration id: zoho_crm, …
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([name])
  @@index([nameKey])
  @@map("company")
}

model Contact {
  id        String  @id @default(cuid())
  firstName String
  lastName  String?
  email     String? @unique
  phone     String?
  title     String?
  linkedin  String?
  companyId String?

  tags       String[] @default([])
  ownerEmail String?

  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leads         Lead[]
  opportunities Opportunity[]
  activities    Activity[]
  noteEntries   Note[]
  tasks         Task[]
  prospects     Prospect[]


  /// The provider's own id for this record, when a sync imported it. Lets a re-sync
  /// update in place instead of duplicating — the pattern Campaign already uses.
  externalId String?
  source     String? // integration id: zoho_crm, …
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([companyId])
  @@index([lastName, firstName])
  @@map("contact")
}

// ─── the funnel ───────────────────────────────────────────────────────────────

/// Every inbound hand-raise. Keeps its own contact details so a lead can arrive from a
/// form before anyone decides it deserves a Contact row; dedupe then links the two.
model Lead {
  id        String  @id @default(cuid())
  firstName String
  lastName  String?
  email     String?
  phone     String?
  companyName String?
  title     String?
  message   String?

  status     LeadStatus @default(new)

  /// The lead source exactly as the CRM wrote it. `sourceType` collapses "ig", "fb" and
  /// "Whatsapp" into one value; which platform it actually was is the question the
  /// Marketing page exists to answer.
  sourceDetail String?

  /// The status exactly as the source CRM wrote it. `status` above is a shared vocabulary
  /// and has to collapse this org's wording — Dead Lead, Follow-up, Not Reachable — into
  /// `lost` and `contacted`, and those distinctions are the ones the team works to.
  sourceStatus String?
  sourceType SourceType @default(manual)
  ownerEmail String?

  /// Deterministic lead quality, 0-100. §7.3.
  ///
  /// Was a column with no rules behind it and 0 on all 27,575 rows, which reads on screen
  /// as a score of zero rather than as no score. Now computed in lib/lead-score.ts from
  /// five named components — source tier, company email, phone, segment and stated intent
  /// — and never by the model: a score the agent assigned would not be reproducible from
  /// the record, which is the whole point of it.
  score Int @default(0)

  /// Which version of the formula produced `score`.
  ///
  /// Null means the score predates the rules and is the placeholder zero, not a genuine
  /// zero. Without this the two are indistinguishable, and the trend the score exists to
  /// serve would silently compare leads scored under different formulas.
  scoreVersion Int?

  /// One of the segments in lib/lead-segment.ts, or null where the lead did not say.
  ///
  /// §7.4. Read from the answer the person gave on the lead form — Zoho has no segment
  /// field, and one added for somebody to fill in across 27,575 leads is a field that
  /// stays empty. Null on the 22,914 leads that carry no message: inventing a segment for
  /// four fifths of the base would make the mix on the dashboard describe nothing.
  segment String?

  /// Why a lost lead was lost. §7.6, and null unless the lead is lost or unqualified.
  ///
  /// `unstated` is a real value and the largest bucket: "Dead Lead" says the lead is dead
  /// and not why, and mapping 9,867 of those onto one of the six named reasons would
  /// manufacture the concentration the lost-reason insight looks for.
  lostReason String?

  /// How much the channel on this row is worth as evidence. G1.2.
  ///
  /// `reported` — the CRM's own source string matched a rule written against this
  /// account's 56 measured values. `inferred` — the string meant nothing, but the
  /// `sourceType` enum knew a category. `none` — nothing reached a channel.
  ///
  /// Every channel figure previously treated the first two as equally certain facts.
  attributionConfidence String?

  /// Suppression flags. §7.7: "a client receiving a cold sequence is a relationship
  /// event, not a metric." The Outreach control in §14 cannot exist without them.
  isClient          Boolean @default(false)
  isReferralPartner Boolean @default(false)

  /// Which registered partner sent this lead. §8.5. Null on the 217 referral leads that
  /// predate the registry — their partner is free text inside `sourceDetail` and cannot
  /// be resolved without guessing.
  referralPartnerId String?

  campaignId String?
  channelId  String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  landingPage String?
  referrer    String?

  contactId String?
  companyId String?

  /// Set when status first becomes `qualified`, so time-to-qualify is a subtraction
  /// rather than a scan of the activity log.
  qualifiedAt DateTime?
  convertedAt DateTime?

  tags String[] @default([])

  campaign      Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  channel       Channel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  referralPartner ReferralPartner? @relation(fields: [referralPartnerId], references: [id], onDelete: SetNull)
  contact       Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunities Opportunity[]
  activities    Activity[]
  noteEntries   Note[]
  tasks         Task[]


  /// The provider's own id for this record, when a sync imported it. Lets a re-sync
  /// update in place instead of duplicating — the pattern Campaign already uses.
  externalId String?
  source     String? // integration id: zoho_crm, …
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([status])
  @@index([sourceStatus])
  @@index([sourceDetail])
  @@index([email])
  @@index([createdAt])
  @@index([campaignId])
  @@map("lead")
}

model Pipeline {
  id        String  @id @default(cuid())
  name      String
  isDefault Boolean @default(false)

  stages        PipelineStage[]
  opportunities Opportunity[]

  createdAt DateTime @default(now())

  @@map("pipeline")
}

model PipelineStage {
  id         String @id @default(cuid())
  pipelineId String
  name       String
  position   Int

  /// Default win probability for deals in this stage, 0-100. Weighted pipeline value
  /// uses the opportunity's own probability, which starts from this.
  probability Int @default(0)

  isWon  Boolean @default(false)
  isLost Boolean @default(false)

  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([pipelineId, position])
  @@map("pipeline_stage")
}

model Opportunity {
  id         String @id @default(cuid())
  name       String
  pipelineId String
  stageId    String

  value       Decimal  @db.Decimal(14, 2)
  currency    String   @default("USD")
  probability Int      @default(0)
  expectedCloseDate DateTime?
  closedAt    DateTime?

  ownerEmail String?

  /// ── Read out of the deal name (see lib/deal-name.ts) ──────────────────────
  /// This CRM has no field for either of these, but the naming convention carries both
  /// and has for thousands of records: "Mosaic Wellness INC_46_Apr'26_One Time".
  ///
  /// Derived at import and by tools/backfill-deal-origin.ts, not computed on read, so the
  /// metrics layer can group on them in SQL rather than parsing 8,000 strings per request.

  /// new | repeat | unknown — whether this is the first engagement for the account.
  /// `unknown` is a quarter of the book and must stay distinct from `new`: treating an
  /// unparsed name as new business is the overstatement G1.4 exists to remove.
  dealOrigin String?

  /// name | account-history — what dealOrigin was read from.
  ///
  /// The name is a statement by the person who opened the deal; account history is an
  /// inference this app drew (see lib/deal-origin.ts), right about 98% of the time when
  /// checked against the names. They are not the same class of evidence and a reader
  /// deciding how hard to lean on a figure needs to be able to tell them apart. Null
  /// wherever dealOrigin is null or 'unknown'.
  originSource String?

  /// one_time | retainer, from the suffix. §8.2's Engagement_Type.
  engagementType String?

  /// The per-account engagement counter from the name. Kept because it is the evidence
  /// for dealOrigin — a deal numbered 46 is self-evidently not new business.
  accountSequenceNo Int?

  leadId     String?
  contactId  String?
  companyId  String?
  campaignId String?

  /// The CRM's own wording for where the deal came from, stored beside the mapped
  /// channel and never instead of it.
  ///
  /// The same reason Lead.sourceDetail exists: a source that maps to no channel is
  /// otherwise invisible, and the gap reads as "no source" when it may only be a mapping
  /// this app has not learned yet. "Trademark_Meta" sat unattributed on 44 leads for
  /// exactly that reason, and was only findable because the raw string was kept.
  sourceDetail String?

  /// @@index([dealOrigin]) is declared at the foot of this model.
  /// The channel the deal itself was credited to, from the CRM's own Lead_Source on the
  /// deal record.
  ///
  /// Separate from the lead's channel because most deals have no lead: 6,886 of 7,810 here
  /// were opened straight on an account or contact and never converted from one. Revenue
  /// attributed by walking deal -> lead -> channel could therefore only ever reach 12% of
  /// the money, while the source of every one of them sat unread on the deal itself.
  channelId  String?

  lostReason String?

  /// The deal's channel as evidence. G1.2, and weaker than a lead's by construction: a
  /// deal has no source string of its own here, so its channel is inherited from the lead
  /// it converted from — and 90% of deals were never converted from one. See
  /// lib/attribution-confidence.ts.
  attributionConfidence String?

  /// Which registered partner this deal came through. §8.5.
  referralPartnerId String?

  pipeline   Pipeline      @relation(fields: [pipelineId], references: [id])
  stage      PipelineStage @relation(fields: [stageId], references: [id])
  lead       Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company    Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  campaign   Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  channel    Channel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  referralPartner ReferralPartner? @relation(fields: [referralPartnerId], references: [id], onDelete: SetNull)
  customer   Customer?
  activities Activity[]
  noteEntries Note[]
  tasks      Task[]
  revenue    RevenueEntry[]


  /// The provider's own id for this record, when a sync imported it. Lets a re-sync
  /// update in place instead of duplicating — the pattern Campaign already uses.
  externalId String?
  source     String? // integration id: zoho_crm, …
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([stageId])
  @@index([companyId])
  @@index([campaignId])
  @@index([dealOrigin])
  @@map("opportunity")
}

/// A won company. Separate from Company because "is a customer" has its own dates and
/// lifecycle that a CRM record does not.
model Customer {
  id        String @id @default(cuid())
  companyId String @unique

  /// The deal that won them. Kept so first-touch attribution survives even if later
  /// revenue rows carry no campaign.
  opportunityId String? @unique

  wonAt    DateTime
  churnedAt DateTime?

  /// §8.2's four lifecycle flags, as dates rather than booleans.
  ///
  /// "Renewal and referral are the cheapest revenue in the firm and currently have no
  /// system of record anywhere." These four columns are that record.
  ///
  /// Dates, not booleans, and the difference matters: "a review was requested" is a
  /// weaker fact than "a review was requested in March", and the flag §8.2 actually asks
  /// for is "no review requested" — which is a question about recency for a client of
  /// three years, not about whether it ever happened once.
  ///
  /// Null means never, and stays null until somebody records it. Nothing infers these
  /// from activity: a call logged against an account is not evidence that a referral was
  /// asked for, and treating it as such would fill the registry with work nobody did.
  reviewRequestedAt  DateTime?
  referralAskedAt    DateTime?
  crossSellOfferedAt DateTime?

  /// When the retainer comes up. Null for a one-off engagement and for any retainer whose
  /// term nobody has entered — §8.2's "retainer renewal inside 60 days" flag needs a date
  /// and this CRM records none, so it is entered here or it is not known.
  renewalDueAt DateTime?

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  revenue     RevenueEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer")
}

/// Money in. Carries campaign and channel directly so revenue attribution is one join
/// rather than a walk back up the funnel.
model RevenueEntry {
  id         String   @id @default(cuid())
  customerId String
  date       DateTime @db.Date
  amount     Decimal  @db.Decimal(14, 2)
  currency   String   @default("USD")
  kind       String   @default("one_time") // one_time | recurring | expansion | refund

  opportunityId String?
  campaignId    String?
  channelId     String?

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  campaign    Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  channel     Channel?     @relation(fields: [channelId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// Derived rows are keyed on the deal that produced them, so a re-sync corrects the
  /// amount rather than adding a second entry. Manual revenue carries no opportunity and
  /// is unaffected — Postgres does not collide on NULLs.
  @@unique([opportunityId])
  @@index([date])
  @@index([campaignId])
  @@map("revenue_entry")
}

// ─── history, notes, tasks ────────────────────────────────────────────────────

/// Append-only. Nothing updates or deletes these rows; they are the lifecycle history
/// for whatever they point at. Exactly one of the entity ids is set.
model Activity {
  id      String       @id @default(cuid())
  type    ActivityType
  summary String

  /// Who caused it. An email rather than a user id because there is no User table —
  /// identity comes from the roster.
  actorEmail String?

  /// Shape depends on `type`: {from,to} for status_changed, {stageId} for
  /// stage_changed, {provider,rows} for synced.
  detail Json?

  leadId        String?
  contactId     String?
  companyId     String?
  opportunityId String?

  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  /// Set when a sync imported this instead of the app recording it, so a re-sync updates
  /// in place — the pattern Lead and Opportunity already use.
  externalId String?
  source     String? // integration id: zoho_crm, …

  createdAt DateTime @default(now())

  @@unique([source, externalId])
  @@index([leadId, createdAt])
  @@index([opportunityId, createdAt])
  @@index([createdAt])
  @@index([source, createdAt])
  @@map("activity")
}

model Note {
  id       String @id @default(cuid())
  body     String
  authorEmail String

  leadId        String?
  contactId     String?
  companyId     String?
  opportunityId String?

  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("note")
}

model Task {
  id       String     @id @default(cuid())
  title    String
  detail   String?
  status   TaskStatus @default(open)
  priority Priority   @default(normal)
  dueDate  DateTime?

  assigneeEmail String?
  createdByEmail String?
  completedAt   DateTime?

  leadId        String?
  contactId     String?
  companyId     String?
  opportunityId String?

  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  externalId String?
  source     String? // integration id: zoho_crm, …

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([status, dueDate])
  @@index([assigneeEmail])
  @@map("task")
}

// ─── metrics ──────────────────────────────────────────────────────────────────

/// The one time-series table. Every integration writes here; every chart reads here.
///
/// `source` is an integration id ("google_analytics") or "manual". `entityType` and
/// `entityId` scope the value — ("site", null) for a whole-site session count,
/// ("campaign", <id>) for one campaign's impressions, ("keyword", <id>) for a ranking.
/// The unique constraint makes a re-sync idempotent: the same day re-syncs to an
/// upsert, not a duplicate row.
model MetricSnapshot {
  id         String @id @default(cuid())
  source     String
  entityType String

  /// NOT nullable, and "" means "no particular entity" (a whole-site session count).
  /// Postgres treats NULLs as distinct in a unique index, so a nullable column here
  /// would let the same day be inserted twice and make the upsert in
  /// lib/integrations/service.ts never match — site metrics would double-count the
  /// moment a real provider synced alongside the seeded rows.
  entityId String @default("")

  metricKey  String
  date       DateTime @db.Date
  value      Decimal  @db.Decimal(18, 4)

  createdAt DateTime @default(now())

  @@unique([source, entityType, entityId, metricKey, date])
  @@index([metricKey, date])
  @@index([date])
  @@map("metric_snapshot")
}

// ─── integrations ─────────────────────────────────────────────────────────────

/// One row per provider. `state` is what the Integration Center renders — it is never
/// inferred from whether a credential happens to exist.
model Integration {
  id       String           @id @default(cuid())
  provider String           @unique // matches the key in lib/integrations/registry.ts
  state    IntegrationState @default(disconnected)

  lastSyncAt      DateTime?
  lastSyncRows    Int?

  /// Where a paged pull stopped when it ran out of time. Non-null means a backfill is in
  /// progress; the next run resumes from here instead of starting again.
  syncCursor Json?

  /// High-water mark. Once a full pass completes, later syncs ask the provider only for
  /// records modified since this instant, which is what keeps a nightly sync in seconds
  /// rather than re-importing the whole CRM.
  syncedThrough DateTime?
  lastError       String?
  lastErrorAt     DateTime?
  connectedByEmail String?
  connectedAt     DateTime?

  /// Non-secret settings: the GA4 property id, the ad account id, the tracked domain.
  /// Secrets go in IntegrationCredential, never here.
  config Json?

  credential IntegrationCredential?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("integration")
}

/// One row per attempt to sync one provider. G5.1.
///
/// Integration carries only `lastSyncAt`, `lastSyncRows` and `lastError`, so each run
/// overwrote the one before it. A provider that failed for six nights and then succeeded
/// looked, the next morning, exactly like one that had never failed — there was no way to
/// tell a healthy integration from a lucky one, and no way to see that a nightly sync had
/// been importing four rows since April.
///
/// Written on both outcomes. A run that failed is the row most worth having; recording
/// only the successes would reproduce the same blind spot with more storage.
model SyncRun {
  id       String @id @default(cuid())
  provider String

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// running | succeeded | failed | skipped.
  ///
  /// Text rather than an enum because a run's outcome is written by the sync loop and
  /// read by a panel; adding an outcome should not be a migration on a hot table.
  status String @default("running")

  /// Rows written. Zero on a failure, and zero is a real answer on a success too — a
  /// provider with nothing new to report is not the same as one that broke.
  rows Int @default(0)

  /// Wall-clock milliseconds. The number that says a nightly sync is drifting towards the
  /// platform's 300-second ceiling before it starts being killed there.
  durationMs Int?

  /// The provider's own summary, and the error when there was one. Both nullable: a
  /// successful run has no error, and a run killed by the platform has no summary.
  detail String?
  error  String?

  /// False when a paged backfill ran out of time and has more to fetch. A run that ended
  /// incomplete succeeded at what it attempted, which is not the same as being finished.
  complete Boolean @default(true)

  /// Who asked. Null is the cron; an email is somebody pressing Sync now.
  actorEmail String?

  /// Indexed by provider and start, because every query here is "the last N runs of this
  /// provider" and there will eventually be tens of thousands of rows.
  @@index([provider, startedAt])
  @@index([startedAt])
  @@map("sync_run")
}

/// Split from Integration so a query that renders a card cannot accidentally select a
/// secret. `ciphertext` is AES-256-GCM under APP_ENCRYPTION_KEY — see lib/crypto.ts.
model IntegrationCredential {
  id            String @id @default(cuid())
  integrationId String @unique

  ciphertext String
  iv         String
  authTag    String

  expiresAt DateTime?

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("integration_credential")
}

/// Everyone who has signed in. Rows are created automatically on first sign-in — the
/// only gate is the Google account's domain (see ALLOWED_DOMAINS in lib/roles.ts), so
/// there is no allow-list to maintain and no way to lock the whole team out.
///
/// `role` is retained but not currently enforced: can() grants every permission to any
/// signed-in user. The column is here so tiered access can be switched back on without
/// a migration — see the note in lib/roles.ts.
model AppUser {
  id    String @id @default(cuid())

  /// Canonical address: the local part on the primary domain. Someone signing in as
  /// name@bngadvisors.com resolves to the same row as name@usaindiacfo.com, which is
  /// what keeps ownerEmail values across the schema pointing at one person.
  email String @unique

  name        String
  initials    String
  displayRole String?
  team        String?

  /// Least privilege by default: someone signing in for the first time can work, not
  /// administer. The admin mailboxes are lifted to owner by ensureAdmins().
  role   Role    @default(user)
  active Boolean @default(true)

  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_user")
}

/// Lets a website form POST leads to /api/public/v1/leads. Only the hash is stored, so
/// a leaked database does not leak usable keys; the plaintext is shown once on creation.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  hash       String    @unique
  prefix     String
  createdByEmail String
  lastUsedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@map("api_key")
}

// ─── SEO ──────────────────────────────────────────────────────────────────────

model Website {
  id     String @id @default(cuid())
  domain String @unique
  name   String

  keywords SeoKeyword[]
  pages    SeoPage[]

  createdAt DateTime @default(now())

  @@map("website")
}

model SeoKeyword {
  id        String @id @default(cuid())
  websiteId String
  keyword   String
  country   String @default("us")

  searchVolume Int?
  difficulty   Int?
  cpc          Decimal? @db.Decimal(10, 2)
  intent       String?
  isTracked    Boolean  @default(true)

  /// Which integration reported this keyword, or null for a row the seeder invented.
  /// Same purpose as SocialAccount.integrationId: the SEO page has to be able to say
  /// which rankings are real, and a table-wide flag could not survive live and seeded
  /// rows sitting side by side.
  source String?

  website  Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  rankings SeoKeywordRanking[]

  createdAt DateTime @default(now())

  @@unique([websiteId, keyword, country])
  @@map("seo_keyword")
}

/// One position reading on one day. History is the point — a single `position` column
/// on SeoKeyword could not answer "what moved this month".
model SeoKeywordRanking {
  id        String   @id @default(cuid())
  keywordId String
  date      DateTime @db.Date
  position  Int
  url       String?

  keyword SeoKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([keywordId, date])
  @@index([date])
  @@map("seo_keyword_ranking")
}

model SeoPage {
  id        String @id @default(cuid())
  websiteId String
  url       String
  title     String?

  clicks      Int   @default(0)
  impressions Int   @default(0)
  ctr         Float @default(0)
  avgPosition Float @default(0)

  /// Technical findings as [{code, severity, message}]. A JSON column rather than an
  /// issues table: nothing queries across issues yet, and the shape comes from whichever
  /// crawler produced it.
  issues Json?

  /// As on SeoKeyword — the integration that reported it, null when seeded.
  source String?

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([websiteId, url])
  @@map("seo_page")
}

// ─── social ───────────────────────────────────────────────────────────────────

model SocialAccount {
  id       String        @id @default(cuid())
  network  SocialNetwork
  handle   String
  name     String?
  followers Int          @default(0)

  /// Whether this account's data is arriving from a live connection. Read from the
  /// owning Integration, never assumed.
  integrationId String?

  posts SocialPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// §13: who is answerable for this profile.
  ///
  /// Profiles were the one owned thing in the app with no owner, so "the AA page has not
  /// posted in three weeks" was a finding addressed to nobody. Free text rather than a
  /// relation to AppUser for the reason Lead.ownerEmail is: most of the people who run
  /// these profiles hold no account here.
  ownerEmail String?

  @@unique([network, handle])
  @@map("social_account")
}

model SocialPost {
  id        String   @id @default(cuid())
  accountId String
  externalId String?
  publishedAt DateTime
  permalink String?
  caption   String?

  reach       Int @default(0)
  impressions Int @default(0)
  likes       Int @default(0)
  comments    Int @default(0)
  shares      Int @default(0)
  // Instagram's nearest equivalent to a share, and kept apart from one: it is a
  // different action, and only one of the two networks reports each.
  saves       Int @default(0)
  clicks      Int @default(0)

  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([accountId, externalId])
  @@index([publishedAt])
  @@map("social_post")
}

// ─── outreach ─────────────────────────────────────────────────────────────────

model Sequence {
  id     String @id @default(cuid())
  name   String
  status String @default("draft") // draft | active | paused | archived
  ownerEmail String?

  /// ── The registry (§14.2) ──────────────────────────────────────────────────
  /// Written here and never by a sync: the sending platform knows none of this, and
  /// writeOutreach only ever touches name, status, source and externalId, so a nightly
  /// pull cannot quietly clear an approval.

  /// cold_acquisition | event_followup | client_reminder | dormant_revival.
  /// A String rather than an enum, matching `status` above — the vocabulary is the
  /// manual's proposal and is likely to move once it meets the real campaigns.
  purpose       String?
  segment       String?
  serviceLine   String?
  /// Which domain the sequence sends from. The routing rule in §14.3 turns on this.
  sendingDomain String?

  /// Copy signed off, and the statutory figures in it verified. Two separate acts by two
  /// different people, so two sets of columns rather than one flag.
  copyApprovedByEmail    String?
  copyApprovedAt         DateTime?
  numbersVerifiedByEmail String?
  numbersVerifiedAt      DateTime?

  /// A hash of the steps as they stood when each sign-off was given. An approval is only
  /// an approval of what was read: without this, someone approves a template, the copy is
  /// then edited or re-synced from Smartlead, and the tick silently stands over text
  /// nobody has seen. Compared on read; a mismatch reports the approval as stale rather
  /// than valid.
  copyApprovedHash    String?
  numbersVerifiedHash String?

  steps     SequenceStep[]
  prospects Prospect[]


  /// The provider's own id for this row, when a sync imported it. Lets a re-sync update
  /// in place instead of duplicating — the pattern Campaign already uses.
  externalId String?
  source     String? // integration id: smartlead, …

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@map("sequence")
}

model SequenceStep {
  id         String @id @default(cuid())
  sequenceId String
  position   Int

  /// Days to wait after the previous step before this one is due.
  waitDays Int    @default(0)
  channel  String @default("email") // email | linkedin | call
  subject  String?
  body     String

  sequence Sequence          @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  messages OutreachMessage[]

  @@unique([sequenceId, position])
  @@map("sequence_step")
}

model Prospect {
  id         String         @id @default(cuid())
  sequenceId String
  contactId  String?
  email      String
  firstName  String?
  lastName   String?
  companyName String?
  status     ProspectStatus @default(pending)
  currentStep Int           @default(0)

  sequence Sequence          @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact  Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages OutreachMessage[]


  /// The provider's own id for this row, when a sync imported it. Lets a re-sync update
  /// in place instead of duplicating — the pattern Campaign already uses.
  externalId String?
  source     String? // integration id: smartlead, …

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@unique([sequenceId, email])
  @@map("prospect")
}

model OutreachMessage {
  id         String @id @default(cuid())
  prospectId String
  stepId     String

  /// sent | failed | skipped. Written by whichever EmailProvider handled it — the
  /// console provider records "sent" without sending, and says so in `providerId`.
  status     String    @default("sent")
  providerId String?
  sentAt     DateTime  @default(now())
  openedAt   DateTime?
  repliedAt  DateTime?
  error      String?

  prospect Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  step     SequenceStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([prospectId, sentAt])
  @@map("outreach_message")
}

// ─── content ──────────────────────────────────────────────────────────────────

model ContentPiece {
  id     String        @id @default(cuid())
  title  String
  status ContentStatus @default(idea)
  format String        @default("blog") // blog | video | social | email | landing_page | case_study

  authorEmail String?
  channelSlug String?
  campaignId  String?

  brief       String?
  url         String?
  publishDate DateTime?

  /// §15.2's record. Everything the agent reviews and everything the reports count hangs
  /// off this, and none of it existed: the board had a title, a format and a brief.
  ///
  /// Free text against documented vocabularies rather than enums, for the same reason the
  /// company facts are — these are filled in by hand and a new service line should not be
  /// a migration. lib/content-fields.ts holds the lists the form reads.
  topicCluster String?
  segment      String?
  serviceLine  String?
  /// The term from §11.6 this piece is written to rank for. Joined to SeoKeyword by the
  /// word itself rather than by id: a keyword can be dropped from tracking, and the
  /// intention behind a published article survives that.
  targetKeyword String?

  designerEmail String?
  /// Whose voice it goes out in. Distinct from the author: a partner-voiced post written
  /// by the studio needs that partner's approval, and §21 makes that a different
  /// signature from the marketing sign-off.
  partnerVoice  String?

  /// Where the asset lives before it is published. `url` is the published address; this
  /// is the doc, the design file or the cut.
  assetUrl String?

  /// §15.4's provenance. Which system created this row — search_console, zoho_social,
  /// backstage — or null where a person did. An auto-created item is a claim about the
  /// outside world and a hand-made one is a plan, and the board reads differently if you
  /// cannot tell them apart.
  createdBy String?

  /// One idea into ten assets. §15.4's webinar creates "the parent item plus the clip,
  /// blog and remarketing-audience children the plan expects".
  ///
  /// SetNull rather than Cascade: deleting a webinar must not delete the three articles
  /// cut from it. They outlive their parent and go on earning.
  parentId String?
  parent   ContentPiece?  @relation("Repurposed", fields: [parentId], references: [id], onDelete: SetNull)
  children ContentPiece[] @relation("Repurposed")

  views       Int @default(0)
  leadsGenerated Int @default(0)

  tags String[] @default([])

  /// ── Approval (see lib/content-approval.ts) ────────────────────────────────────────
  ///
  /// §21.2: "Approve records her identity, the time and the exact card version she saw.
  /// Return quotes the finding back to the author and keeps the SLA clock running."

  /// Who approved it, when, and a hash of what they were looking at.
  ///
  /// The hash is the load-bearing part. Without it an approval says "Shweta approved
  /// this piece", which stops being true the moment somebody edits the title or the
  /// brief — the same problem the sequence registry solved, and solved this way.
  approvedByEmail String?
  approvedAt      DateTime?
  approvedHash    String?

  /// Sent back to its author with a reason, rather than approved.
  ///
  /// §21.2 requires the SLA clock to keep running through a return, so `returnedAt` is
  /// not a reset — the age of the piece is still measured from when it entered review.
  /// Both are cleared when it is approved.
  returnedAt   DateTime?
  returnedNote String?

  /// When it entered review. The clock §21.2 refers to, and the reason a return cannot
  /// simply restart it: bouncing a piece back would otherwise make it look new.
  reviewStartedAt DateTime?

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([parentId])
  @@map("content_piece")
}

// ─── AI, notifications, audit ─────────────────────────────────────────────────

/// A generated insight. `provider` records what produced it — "anthropic" for a real
/// call, "seed" for the labelled examples that ship with the demo data. The UI shows
/// that distinction rather than presenting seeds as analysis.
model AiInsight {
  id       String      @id @default(cuid())
  kind     InsightKind
  title    String
  body     String
  provider String      @default("seed")
  model    String?

  /// What the insight is about, for deep-linking: {module:"leads", campaignId:"…"}.
  context Json?

  /// 0-100, from the model. Null when the provider gave none.
  confidence Int?

  /// ── Identity across runs (see lib/insight-identity.ts) ────────────────────────────
  ///
  /// A finding is about something, and the something outlives the sentence describing it.
  /// Regeneration used to delete the whole set and write a new one, so a problem in its
  /// fourth month read as discovered this morning, and a dismissal lasted until the next
  /// run. These three columns are what let a finding be recognised as the same finding.

  /// A short slug naming WHAT the finding is about — "roas-below-one", not the wording.
  /// Supplied by the model, which is given the open subjects and asked to reuse one where
  /// the finding is the same issue. Null on seeded rows, which have no run history.
  subject String?

  /// kind + subject, hashed. Unique, so a re-run updates the row rather than adding a
  /// second copy of the same finding.
  fingerprint String? @unique

  /// When this finding was first raised, and when a run last still found it true. Both
  /// are the run's timestamp, not the row's: createdAt already says when the row was
  /// written, which after an update is a different question.
  firstSeenAt DateTime?
  lastSeenAt  DateTime?

  /// Stamped when a run no longer reports the finding. Kept rather than deleted: "this
  /// stopped being true on the 4th" is worth more than the row's absence, and a finding
  /// that returns should be recognisably the same one.
  resolvedAt DateTime?

  /// ── Provenance: which rule raised this, over what (see lib/insight-rules.ts) ──────
  ///
  /// §20.1: "Every insight originates in a deterministic rule over the metrics table. The
  /// model narrates, prioritises and proposes; it never computes a number." These columns
  /// are what make that checkable after the fact rather than a claim in a comment.

  /// e.g. attribution_health_below_threshold. Null on a row no rule produced — the seeded
  /// samples, and the findings written before the engine existed.
  ruleId      String?
  ruleVersion Int?

  /// dashboard | leads | crm | pipeline | marketing | seo | ads | social | outreach |
  /// content | analytics | tasks. Where the finding belongs, from the rule.
  section String?

  /// The figures the rule computed, and where they came from. Every number in the title
  /// and narrative must appear here: the model is handed this and forbidden to introduce
  /// a figure that is not in it, which is the only mechanical check on invention there
  /// can be.
  evidence Json?

  /// The window the rule actually ran on. Not the same as createdAt, and the difference
  /// matters when a finding is re-confirmed months later.
  periodStart DateTime?
  periodEnd   DateTime?

  /// ── The action lifecycle (see lib/insight-actions.ts) ─────────────────────────────
  ///
  /// §20.1: "Every insight becomes an action item with an owner, or it is dismissed with
  /// a written reason. No orphan commentary."

  /// proposed | reviewed | approved | assigned | in_progress | done | dismissed.
  ///
  /// The single truth about where a finding stands. `dismissedAt` is kept as the
  /// timestamp for the dismissed state and is only ever written beside this column, by
  /// setInsightStatus — two fields that can disagree about one fact is this repository's
  /// documented failure mode.
  status String @default("proposed")

  /// critical | high | medium | info. Null until a rule sets it: the current findings
  /// come from a model that was never asked to grade them, and inventing a severity for
  /// them here would be exactly the computation §20.1 forbids the model.
  severity String?

  /// One concrete step, imperative. Written by the model.
  proposedAction String?

  /// Who is meant to act. A company address, checked against the addresses that actually
  /// appear as users or as CRM record owners — the manual's role map names six people
  /// (Gaurav, Kriti, Dakshita, Abhuday, Islam, Riyaz) who hold no account here and own no
  /// records, so a mapping written from those names would resolve to nobody.
  ownerEmail String?

  /// Recorded on every transition, and required to dismiss. The reason a finding was let
  /// go is the part worth keeping: without it a quiet page cannot be told apart from a
  /// page whose findings were all judged and closed.
  reviewNote      String?
  reviewedByEmail String?
  reviewedAt      DateTime?

  /// The second signature. D8: "Reviewed is one state — it does not distinguish Abhuday's
  /// review from Shweta's approval."
  ///
  /// Kept apart from `reviewedByEmail` rather than overwriting it, because the two-step
  /// exists precisely so that both names are on the record. One column holding whoever
  /// touched it last would answer "who approved this?" with the reviewer's name on any
  /// finding sent back and re-reviewed, which is the question the second step was added
  /// to make answerable.
  approvedByEmail String?
  approvedAt      DateTime?

  dismissedAt DateTime?

  /// Appendix B's last three fields.
  ///
  /// `promptVersion` — which build of the narration prompt produced `title` and `body`.
  /// The rule's own version is already stored beside it, and that is the half nobody
  /// argues about: what changed silently was the wording, and two insights narrated by
  /// different prompts are not comparable however identical their evidence.
  promptVersion String?

  /// A hash of the evidence the model was actually shown.
  ///
  /// The same device content approval uses, for the same reason. Without it an insight
  /// says "the model wrote this about these figures", which stops being true the moment
  /// a re-run computes different figures under the same fingerprint — and re-runs are
  /// nightly. With it, a body and the numbers it describes can be shown to belong
  /// together, or shown not to.
  contextHash String?

  /// §19.3: "Action items from the insight engine write to Zoho Projects as tasks,
  /// idempotently — one task per insight, ever."
  ///
  /// The idempotency key is this column rather than a lookup by title: a task renamed in
  /// Projects would otherwise be invisible to the next run and be created again, which is
  /// exactly the duplicate the clause forbids.
  taskId String? @unique

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([resolvedAt])
  @@index([status])
  @@index([ruleId])
  @@map("ai_insight")
}

/// One proposed merge, waiting for a person. §8.1 and G5.3.
///
/// The CRM page has read "Duplicates merged: 0" since it was built, and that zero was
/// never a fact about the data — nothing was scanning. Duplicates corrupt customer
/// counts, CAC and every per-account average on that screen.
///
/// Deliberately a queue rather than an automatic merge. Merging is destructive and
/// irreversible, two records that look identical are sometimes a parent company and its
/// subsidiary, and there are 27,575 leads here. A queue somebody works through is slower
/// and is the only version that cannot silently destroy an account.
model DuplicateCandidate {
  id String @id @default(cuid())

  /// lead | company | contact. Text rather than an enum: the scanner covers three tables
  /// today and adding a fourth should not be a migration on a table this size.
  entityType String

  /// The record proposed to survive, and the one proposed to be folded into it. Ordered
  /// by lib/duplicates.ts `chooseSurvivor` — richest first, then oldest — because this
  /// workspace re-imported its CRM and the *older* row is often the bare stub.
  primaryId   String
  duplicateId String

  /// Which rule matched, and how much it is worth: email 95, phone 85, domain 70,
  /// name 55. Stored rather than recomputed at review time, so the person deciding can
  /// see why the pair was proposed — "same email" and "similar name" ask for quite
  /// different amounts of care.
  rule       String
  confidence Int

  /// The value the two share, so the pair is checkable without opening both records.
  matchedOn String

  /// pending | merged | dismissed.
  ///
  /// A dismissal is as important as a merge and is the reason this table keeps resolved
  /// rows rather than deleting them: without it, every scan would re-propose the pair a
  /// person has already looked at and rejected, and the queue would never empty.
  status String @default("pending")

  resolvedAt    DateTime?
  resolvedBy    String?
  /// Why it was dismissed. Required by the route, not by the column — the same shape
  /// §20.2 uses for dismissing a finding.
  dismissReason String?

  detectedAt DateTime @default(now())

  /// One row per unordered pair per entity type. The scanner writes `primaryId` and
  /// `duplicateId` in a stable order, so the constraint holds against re-scans.
  @@unique([entityType, primaryId, duplicateId])
  @@index([status, confidence])
  @@map("duplicate_candidate")
}

/// §8.5: "Referral is our highest-trust channel and it has no home in any system today.
/// What is not recorded is not followed up."
///
/// A registry, not a report. The referral channel carries 217 leads and every one of them
/// came from somebody the firm knows — but which somebody is recorded, when it is
/// recorded at all, as free text in a lead's source string: "Ref by NG". That string
/// cannot be counted, cannot be thanked and cannot be asked again.
model ReferralPartner {
  id   String @id @default(cuid())
  name String

  /// ca_firm | law_firm | incubator | bank | immigration_adviser | other.
  /// The five §8.5 names plus an escape, as text — see lib/referrals.ts.
  partnerType String @default("other")

  email   String?
  phone   String?
  company String?
  notes   String?

  /// Who owns the relationship. A partner with no owner is a partner nobody rings.
  ownerEmail String?

  /// The last time anybody spoke to them, and the last time they were thanked.
  ///
  /// Separate columns because they are different obligations: "silent beyond 60 days" is
  /// a prompt to make contact, and an unacknowledged referral is a debt. A partner who
  /// sent three clients and was never thanked is the specific failure this table exists
  /// to make visible.
  lastTouchAt        DateTime?
  acknowledgementSentAt DateTime?

  active Boolean @default(true)

  /// The leads and deals credited to this partner. Nullable on both sides: most referral
  /// leads predate the registry and will never be attributed to a named partner, and
  /// pretending otherwise would invent a history.
  leads         Lead[]
  opportunities Opportunity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, partnerType])
  @@map("referral_partner")
}

/// One attempt to deliver one report to one recipient. §17.
///
/// The digest and the weekly pack were fire-and-forget: the route returned a count, the
/// count went to the scheduler, and nothing in the application could answer "did Shweta
/// get Monday's pack?" a day later. SMTP was refusing every message for six weeks and the
/// only evidence was a log line nobody reads.
///
/// One row per recipient, not per send. A digest that reached two of three admins is the
/// case worth being able to see, and a single row carrying `sent: 2` hides which one was
/// missed.
///
/// **What this is not**: proof of reading. SMTP reports that a server accepted the
/// message, and a webhook reports that Cliq accepted it. §17's open tracking needs an ESP
/// that reports opens, which neither of these is — so `openedAt` is deliberately absent
/// rather than present and permanently null.
model ReportDelivery {
  id String @id @default(cuid())

  /// digest | weekly_pack | export. Text rather than an enum: a new report should not be
  /// a migration on a log table.
  report String

  /// email | cliq. Which pipe carried it, because the two fail independently and have
  /// been failing differently — mail refused for weeks while chat would have gone through.
  channel String

  /// The address or the webhook. Stored so a failure names who missed it.
  recipient String

  subject String?

  /// sent | failed. No 'pending': the send is synchronous and a row is written after it
  /// resolves, so a third state would only ever mean the process died mid-loop — which is
  /// exactly what a missing row already says.
  status String

  /// The provider's message id where it gave one, and its refusal where it did not.
  messageId String?
  error     String?

  /// How much was in it, so an empty digest is distinguishable from a failed one.
  itemCount Int?

  sentAt DateTime @default(now())

  @@index([report, sentAt])
  @@index([status, sentAt])
  @@map("report_delivery")
}

model Notification {
  id        String    @id @default(cuid())
  title     String
  body      String?
  level     String    @default("info") // info | success | warning | error
  href      String?
  forEmail  String?
  readAt    DateTime?

  createdAt DateTime @default(now())

  @@index([forEmail, readAt])
  @@map("notification")
}

/// Who changed what. Same purpose as bng-command-center's AuditEvent: a row per write,
/// so a wrong number has a trail.
model AuditEvent {
  id         String @id @default(cuid())
  actorEmail String
  action     String
  entityType String
  entityId   String?
  detail     Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_event")
}
