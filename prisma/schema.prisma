// Growth Center — schema.
//
// Single-tenant on purpose: this is BNG's own marketing team's tool, so there is no
// organizationId anywhere. Access control is the roster in lib/roles.ts, the same
// mechanism bng-command-center uses. If BNG ever runs growth for client companies,
// that becomes a migration, not a rewrite.
//
// Two decisions carry most of the weight here:
//
//   Activity is append-only. Lead status lives on Lead for querying, but every
//   change also writes an Activity row, so "how did this lead get here" is answerable
//   from the table rather than lost to the last UPDATE.
//
//   MetricSnapshot is the only time-series table. Every integration writes into it
//   and every chart reads from it, so adding a provider adds rows, not tables.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Prisma 7 no longer accepts `url` here — the CLI reads it from prisma.config.ts and
// the runtime client builds its own in lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

// ─── enums ────────────────────────────────────────────────────────────────────

/// Mirrors lib/roles.ts. Three tiers, widest first: an owner can do everything including
/// settings, keys and approvals; an admin runs the day to day but cannot approve or reach
/// settings; a user works on records and content.
enum Role {
  owner
  admin
  user
}

enum LeadStatus {
  new
  contacted
  /// This org's own first bar, and most of its worked pipeline: a lead that has passed
  /// an initial screen but has not been fully qualified. It used to be folded into
  /// `qualified` by a substring match, which made 2,480 of 2,490 "qualified" leads
  /// semi-qualified ones. Its own stage so the funnel says which is which.
  semi_qualified
  qualified
  unqualified
  converted
  lost
}

enum SourceType {
  website
  landing_page
  form
  paid_ads
  organic_search
  social
  referral
  outreach
  event
  import
  manual
}

enum ActivityType {
  created
  status_changed
  owner_changed
  note_added
  email
  call
  meeting
  task_completed
  stage_changed
  converted
  synced
}

enum TaskStatus {
  open
  in_progress
  done
  cancelled
}

enum Priority {
  low
  normal
  high
  urgent
}

enum ContentStatus {
  idea
  planned
  draft
  review
  published
  archived
}

/// The five states an integration card may render. Never inferred — always read from
/// the Integration row, so nothing shows "connected" without a credential.
enum IntegrationState {
  disconnected
  connecting
  connected
  syncing
  error
  demo_data
}

enum SocialNetwork {
  instagram
  facebook
  linkedin
  x
  youtube
  tiktok
}

enum ProspectStatus {
  pending
  active
  replied
  bounced
  unsubscribed
  completed
}

enum InsightKind {
  opportunity
  risk
  anomaly
  recommendation
}

// ─── marketing structure ──────────────────────────────────────────────────────

/// A route to market: "Google Ads", "Organic Search", "LinkedIn". Deliberately a table
/// rather than an enum so the team can add one without a migration.
model Channel {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique
  kind String @default("other") // paid | organic | social | email | referral | direct | other

  campaigns Campaign[]
  leads     Lead[]
  revenue   RevenueEntry[]
  opportunities Opportunity[]

  createdAt DateTime @default(now())

  @@map("channel")
}

model Campaign {
  id        String    @id @default(cuid())
  name      String
  channelId String
  status    String    @default("active") // active | paused | completed | draft
  startDate DateTime?
  endDate   DateTime?

  /// Planned budget. Actual money out is the sum of MarketingSpend rows, which is what
  /// every ROAS/CAC figure uses — a budget is an intention, not a cost.
  budget Decimal? @db.Decimal(14, 2)

  /// The currency the budget is stated in — the ad account's, not the workspace's.
  currency String @default("USD")

  /// Whether `budget` is a per-day allowance or one for the campaign's whole run.
  /// "daily" | "lifetime", null when the provider did not say.
  ///
  /// Meta reports one or the other and never both, and the two were collapsed into a
  /// single column. Pacing then divided a month of spend by a single day's budget and
  /// reported 906.9% — the arithmetic was right and the units were not.
  budgetPeriod String?

  /// The provider's own id for this campaign, when it came from one. Lets a sync
  /// update in place instead of duplicating.
  externalId String?
  source     String? // integration id: meta_ads, google_analytics, …

  notes String?

  channel       Channel         @relation(fields: [channelId], references: [id])
  spend         MarketingSpend[]
  leads         Lead[]
  opportunities Opportunity[]
  revenue       RevenueEntry[]
  content       ContentPiece[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([channelId])
  @@map("campaign")
}

/// One day of spend for one campaign. Daily granularity because that is what the ad
/// platforms report and what a date-range filter needs.
/// Workspace preferences, read as a block. JSON per key so adding a preference is not a
/// migration; the shapes are validated in lib/settings.ts where they are read.
model AppSetting {
  key   String @id
  value Json

  updatedAt DateTime @updatedAt

  @@map("app_setting")
}

model MarketingSpend {
  id         String   @id @default(cuid())
  campaignId String
  date       DateTime @db.Date

  amount      Decimal @db.Decimal(14, 2)

  /// The currency the ad platform billed in, which is not necessarily the one the
  /// workspace reports in. Without it a rupee of spend was indistinguishable from a
  /// dollar of it.
  currency    String  @default("USD")
  impressions Int     @default(0)
  clicks      Int     @default(0)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([date])
  @@map("marketing_spend")
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

model Company {
  id       String  @id @default(cuid())
  name     String

  /// `name` reduced by normalizeCompanyName, so "Acme, Inc." and "acme inc" match. Not
  /// unique: two genuinely different accounts can normalise alike, and refusing the
  /// second would lose it.
  nameKey  String?
  domain   String? @unique
  industry String?
  size     String?
  country  String?
  website  String?
  phone    String?
  notes    String?

  /// Plain string array rather than a Tag table and two join tables. One caller, no
  /// tag metadata, and Postgres indexes arrays fine.
  tags String[] @default([])

  ownerEmail String?

  contacts      Contact[]
  leads         Lead[]
  opportunities Opportunity[]
  customer      Customer?
  activities    Activity[]
  noteEntries   Note[]
  tasks         Task[]


  /// The provider's own id for this record, when a sync imported it. Lets a re-sync
  /// update in place instead of duplicating — the pattern Campaign already uses.
  externalId String?
  source     String? // integration id: zoho_crm, …
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([name])
  @@index([nameKey])
  @@map("company")
}

model Contact {
  id        String  @id @default(cuid())
  firstName String
  lastName  String?
  email     String? @unique
  phone     String?
  title     String?
  linkedin  String?
  companyId String?

  tags       String[] @default([])
  ownerEmail String?

  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leads         Lead[]
  opportunities Opportunity[]
  activities    Activity[]
  noteEntries   Note[]
  tasks         Task[]
  prospects     Prospect[]


  /// The provider's own id for this record, when a sync imported it. Lets a re-sync
  /// update in place instead of duplicating — the pattern Campaign already uses.
  externalId String?
  source     String? // integration id: zoho_crm, …
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([companyId])
  @@index([lastName, firstName])
  @@map("contact")
}

// ─── the funnel ───────────────────────────────────────────────────────────────

/// Every inbound hand-raise. Keeps its own contact details so a lead can arrive from a
/// form before anyone decides it deserves a Contact row; dedupe then links the two.
model Lead {
  id        String  @id @default(cuid())
  firstName String
  lastName  String?
  email     String?
  phone     String?
  companyName String?
  title     String?
  message   String?

  status     LeadStatus @default(new)

  /// The lead source exactly as the CRM wrote it. `sourceType` collapses "ig", "fb" and
  /// "Whatsapp" into one value; which platform it actually was is the question the
  /// Marketing page exists to answer.
  sourceDetail String?

  /// The status exactly as the source CRM wrote it. `status` above is a shared vocabulary
  /// and has to collapse this org's wording — Dead Lead, Follow-up, Not Reachable — into
  /// `lost` and `contacted`, and those distinctions are the ones the team works to.
  sourceStatus String?
  sourceType SourceType @default(manual)
  ownerEmail String?

  /// Column only — no scoring rules yet. Present so adding them later is a write path,
  /// not a migration.
  score Int @default(0)

  campaignId String?
  channelId  String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  landingPage String?
  referrer    String?

  contactId String?
  companyId String?

  /// Set when status first becomes `qualified`, so time-to-qualify is a subtraction
  /// rather than a scan of the activity log.
  qualifiedAt DateTime?
  convertedAt DateTime?

  tags String[] @default([])

  campaign      Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  channel       Channel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  contact       Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunities Opportunity[]
  activities    Activity[]
  noteEntries   Note[]
  tasks         Task[]


  /// The provider's own id for this record, when a sync imported it. Lets a re-sync
  /// update in place instead of duplicating — the pattern Campaign already uses.
  externalId String?
  source     String? // integration id: zoho_crm, …
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([status])
  @@index([sourceStatus])
  @@index([sourceDetail])
  @@index([email])
  @@index([createdAt])
  @@index([campaignId])
  @@map("lead")
}

model Pipeline {
  id        String  @id @default(cuid())
  name      String
  isDefault Boolean @default(false)

  stages        PipelineStage[]
  opportunities Opportunity[]

  createdAt DateTime @default(now())

  @@map("pipeline")
}

model PipelineStage {
  id         String @id @default(cuid())
  pipelineId String
  name       String
  position   Int

  /// Default win probability for deals in this stage, 0-100. Weighted pipeline value
  /// uses the opportunity's own probability, which starts from this.
  probability Int @default(0)

  isWon  Boolean @default(false)
  isLost Boolean @default(false)

  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([pipelineId, position])
  @@map("pipeline_stage")
}

model Opportunity {
  id         String @id @default(cuid())
  name       String
  pipelineId String
  stageId    String

  value       Decimal  @db.Decimal(14, 2)
  currency    String   @default("USD")
  probability Int      @default(0)
  expectedCloseDate DateTime?
  closedAt    DateTime?

  ownerEmail String?

  /// ── Read out of the deal name (see lib/deal-name.ts) ──────────────────────
  /// This CRM has no field for either of these, but the naming convention carries both
  /// and has for thousands of records: "Mosaic Wellness INC_46_Apr'26_One Time".
  ///
  /// Derived at import and by tools/backfill-deal-origin.ts, not computed on read, so the
  /// metrics layer can group on them in SQL rather than parsing 8,000 strings per request.

  /// new | repeat | unknown — whether this is the first engagement for the account.
  /// `unknown` is a quarter of the book and must stay distinct from `new`: treating an
  /// unparsed name as new business is the overstatement G1.4 exists to remove.
  dealOrigin String?

  /// one_time | retainer, from the suffix. §8.2's Engagement_Type.
  engagementType String?

  /// The per-account engagement counter from the name. Kept because it is the evidence
  /// for dealOrigin — a deal numbered 46 is self-evidently not new business.
  accountSequenceNo Int?

  leadId     String?
  contactId  String?
  companyId  String?
  campaignId String?

  /// The CRM's own wording for where the deal came from, stored beside the mapped
  /// channel and never instead of it.
  ///
  /// The same reason Lead.sourceDetail exists: a source that maps to no channel is
  /// otherwise invisible, and the gap reads as "no source" when it may only be a mapping
  /// this app has not learned yet. "Trademark_Meta" sat unattributed on 44 leads for
  /// exactly that reason, and was only findable because the raw string was kept.
  sourceDetail String?

  /// @@index([dealOrigin]) is declared at the foot of this model.
  /// The channel the deal itself was credited to, from the CRM's own Lead_Source on the
  /// deal record.
  ///
  /// Separate from the lead's channel because most deals have no lead: 6,886 of 7,810 here
  /// were opened straight on an account or contact and never converted from one. Revenue
  /// attributed by walking deal -> lead -> channel could therefore only ever reach 12% of
  /// the money, while the source of every one of them sat unread on the deal itself.
  channelId  String?

  lostReason String?

  pipeline   Pipeline      @relation(fields: [pipelineId], references: [id])
  stage      PipelineStage @relation(fields: [stageId], references: [id])
  lead       Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company    Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  campaign   Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  channel    Channel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  customer   Customer?
  activities Activity[]
  noteEntries Note[]
  tasks      Task[]
  revenue    RevenueEntry[]


  /// The provider's own id for this record, when a sync imported it. Lets a re-sync
  /// update in place instead of duplicating — the pattern Campaign already uses.
  externalId String?
  source     String? // integration id: zoho_crm, …
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([stageId])
  @@index([companyId])
  @@index([campaignId])
  @@index([dealOrigin])
  @@map("opportunity")
}

/// A won company. Separate from Company because "is a customer" has its own dates and
/// lifecycle that a CRM record does not.
model Customer {
  id        String @id @default(cuid())
  companyId String @unique

  /// The deal that won them. Kept so first-touch attribution survives even if later
  /// revenue rows carry no campaign.
  opportunityId String? @unique

  wonAt    DateTime
  churnedAt DateTime?

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  revenue     RevenueEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer")
}

/// Money in. Carries campaign and channel directly so revenue attribution is one join
/// rather than a walk back up the funnel.
model RevenueEntry {
  id         String   @id @default(cuid())
  customerId String
  date       DateTime @db.Date
  amount     Decimal  @db.Decimal(14, 2)
  currency   String   @default("USD")
  kind       String   @default("one_time") // one_time | recurring | expansion | refund

  opportunityId String?
  campaignId    String?
  channelId     String?

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  campaign    Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  channel     Channel?     @relation(fields: [channelId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// Derived rows are keyed on the deal that produced them, so a re-sync corrects the
  /// amount rather than adding a second entry. Manual revenue carries no opportunity and
  /// is unaffected — Postgres does not collide on NULLs.
  @@unique([opportunityId])
  @@index([date])
  @@index([campaignId])
  @@map("revenue_entry")
}

// ─── history, notes, tasks ────────────────────────────────────────────────────

/// Append-only. Nothing updates or deletes these rows; they are the lifecycle history
/// for whatever they point at. Exactly one of the entity ids is set.
model Activity {
  id      String       @id @default(cuid())
  type    ActivityType
  summary String

  /// Who caused it. An email rather than a user id because there is no User table —
  /// identity comes from the roster.
  actorEmail String?

  /// Shape depends on `type`: {from,to} for status_changed, {stageId} for
  /// stage_changed, {provider,rows} for synced.
  detail Json?

  leadId        String?
  contactId     String?
  companyId     String?
  opportunityId String?

  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  /// Set when a sync imported this instead of the app recording it, so a re-sync updates
  /// in place — the pattern Lead and Opportunity already use.
  externalId String?
  source     String? // integration id: zoho_crm, …

  createdAt DateTime @default(now())

  @@unique([source, externalId])
  @@index([leadId, createdAt])
  @@index([opportunityId, createdAt])
  @@index([createdAt])
  @@index([source, createdAt])
  @@map("activity")
}

model Note {
  id       String @id @default(cuid())
  body     String
  authorEmail String

  leadId        String?
  contactId     String?
  companyId     String?
  opportunityId String?

  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("note")
}

model Task {
  id       String     @id @default(cuid())
  title    String
  detail   String?
  status   TaskStatus @default(open)
  priority Priority   @default(normal)
  dueDate  DateTime?

  assigneeEmail String?
  createdByEmail String?
  completedAt   DateTime?

  leadId        String?
  contactId     String?
  companyId     String?
  opportunityId String?

  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  externalId String?
  source     String? // integration id: zoho_crm, …

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([status, dueDate])
  @@index([assigneeEmail])
  @@map("task")
}

// ─── metrics ──────────────────────────────────────────────────────────────────

/// The one time-series table. Every integration writes here; every chart reads here.
///
/// `source` is an integration id ("google_analytics") or "manual". `entityType` and
/// `entityId` scope the value — ("site", null) for a whole-site session count,
/// ("campaign", <id>) for one campaign's impressions, ("keyword", <id>) for a ranking.
/// The unique constraint makes a re-sync idempotent: the same day re-syncs to an
/// upsert, not a duplicate row.
model MetricSnapshot {
  id         String @id @default(cuid())
  source     String
  entityType String

  /// NOT nullable, and "" means "no particular entity" (a whole-site session count).
  /// Postgres treats NULLs as distinct in a unique index, so a nullable column here
  /// would let the same day be inserted twice and make the upsert in
  /// lib/integrations/service.ts never match — site metrics would double-count the
  /// moment a real provider synced alongside the seeded rows.
  entityId String @default("")

  metricKey  String
  date       DateTime @db.Date
  value      Decimal  @db.Decimal(18, 4)

  createdAt DateTime @default(now())

  @@unique([source, entityType, entityId, metricKey, date])
  @@index([metricKey, date])
  @@index([date])
  @@map("metric_snapshot")
}

// ─── integrations ─────────────────────────────────────────────────────────────

/// One row per provider. `state` is what the Integration Center renders — it is never
/// inferred from whether a credential happens to exist.
model Integration {
  id       String           @id @default(cuid())
  provider String           @unique // matches the key in lib/integrations/registry.ts
  state    IntegrationState @default(disconnected)

  lastSyncAt      DateTime?
  lastSyncRows    Int?

  /// Where a paged pull stopped when it ran out of time. Non-null means a backfill is in
  /// progress; the next run resumes from here instead of starting again.
  syncCursor Json?

  /// High-water mark. Once a full pass completes, later syncs ask the provider only for
  /// records modified since this instant, which is what keeps a nightly sync in seconds
  /// rather than re-importing the whole CRM.
  syncedThrough DateTime?
  lastError       String?
  lastErrorAt     DateTime?
  connectedByEmail String?
  connectedAt     DateTime?

  /// Non-secret settings: the GA4 property id, the ad account id, the tracked domain.
  /// Secrets go in IntegrationCredential, never here.
  config Json?

  credential IntegrationCredential?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("integration")
}

/// Split from Integration so a query that renders a card cannot accidentally select a
/// secret. `ciphertext` is AES-256-GCM under APP_ENCRYPTION_KEY — see lib/crypto.ts.
model IntegrationCredential {
  id            String @id @default(cuid())
  integrationId String @unique

  ciphertext String
  iv         String
  authTag    String

  expiresAt DateTime?

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("integration_credential")
}

/// Everyone who has signed in. Rows are created automatically on first sign-in — the
/// only gate is the Google account's domain (see ALLOWED_DOMAINS in lib/roles.ts), so
/// there is no allow-list to maintain and no way to lock the whole team out.
///
/// `role` is retained but not currently enforced: can() grants every permission to any
/// signed-in user. The column is here so tiered access can be switched back on without
/// a migration — see the note in lib/roles.ts.
model AppUser {
  id    String @id @default(cuid())

  /// Canonical address: the local part on the primary domain. Someone signing in as
  /// name@bngadvisors.com resolves to the same row as name@usaindiacfo.com, which is
  /// what keeps ownerEmail values across the schema pointing at one person.
  email String @unique

  name        String
  initials    String
  displayRole String?
  team        String?

  /// Least privilege by default: someone signing in for the first time can work, not
  /// administer. The admin mailboxes are lifted to owner by ensureAdmins().
  role   Role    @default(user)
  active Boolean @default(true)

  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_user")
}

/// Lets a website form POST leads to /api/public/v1/leads. Only the hash is stored, so
/// a leaked database does not leak usable keys; the plaintext is shown once on creation.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  hash       String    @unique
  prefix     String
  createdByEmail String
  lastUsedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@map("api_key")
}

// ─── SEO ──────────────────────────────────────────────────────────────────────

model Website {
  id     String @id @default(cuid())
  domain String @unique
  name   String

  keywords SeoKeyword[]
  pages    SeoPage[]

  createdAt DateTime @default(now())

  @@map("website")
}

model SeoKeyword {
  id        String @id @default(cuid())
  websiteId String
  keyword   String
  country   String @default("us")

  searchVolume Int?
  difficulty   Int?
  cpc          Decimal? @db.Decimal(10, 2)
  intent       String?
  isTracked    Boolean  @default(true)

  /// Which integration reported this keyword, or null for a row the seeder invented.
  /// Same purpose as SocialAccount.integrationId: the SEO page has to be able to say
  /// which rankings are real, and a table-wide flag could not survive live and seeded
  /// rows sitting side by side.
  source String?

  website  Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  rankings SeoKeywordRanking[]

  createdAt DateTime @default(now())

  @@unique([websiteId, keyword, country])
  @@map("seo_keyword")
}

/// One position reading on one day. History is the point — a single `position` column
/// on SeoKeyword could not answer "what moved this month".
model SeoKeywordRanking {
  id        String   @id @default(cuid())
  keywordId String
  date      DateTime @db.Date
  position  Int
  url       String?

  keyword SeoKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([keywordId, date])
  @@index([date])
  @@map("seo_keyword_ranking")
}

model SeoPage {
  id        String @id @default(cuid())
  websiteId String
  url       String
  title     String?

  clicks      Int   @default(0)
  impressions Int   @default(0)
  ctr         Float @default(0)
  avgPosition Float @default(0)

  /// Technical findings as [{code, severity, message}]. A JSON column rather than an
  /// issues table: nothing queries across issues yet, and the shape comes from whichever
  /// crawler produced it.
  issues Json?

  /// As on SeoKeyword — the integration that reported it, null when seeded.
  source String?

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([websiteId, url])
  @@map("seo_page")
}

// ─── social ───────────────────────────────────────────────────────────────────

model SocialAccount {
  id       String        @id @default(cuid())
  network  SocialNetwork
  handle   String
  name     String?
  followers Int          @default(0)

  /// Whether this account's data is arriving from a live connection. Read from the
  /// owning Integration, never assumed.
  integrationId String?

  posts SocialPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([network, handle])
  @@map("social_account")
}

model SocialPost {
  id        String   @id @default(cuid())
  accountId String
  externalId String?
  publishedAt DateTime
  permalink String?
  caption   String?

  reach       Int @default(0)
  impressions Int @default(0)
  likes       Int @default(0)
  comments    Int @default(0)
  shares      Int @default(0)
  // Instagram's nearest equivalent to a share, and kept apart from one: it is a
  // different action, and only one of the two networks reports each.
  saves       Int @default(0)
  clicks      Int @default(0)

  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([accountId, externalId])
  @@index([publishedAt])
  @@map("social_post")
}

// ─── outreach ─────────────────────────────────────────────────────────────────

model Sequence {
  id     String @id @default(cuid())
  name   String
  status String @default("draft") // draft | active | paused | archived
  ownerEmail String?

  /// ── The registry (§14.2) ──────────────────────────────────────────────────
  /// Written here and never by a sync: the sending platform knows none of this, and
  /// writeOutreach only ever touches name, status, source and externalId, so a nightly
  /// pull cannot quietly clear an approval.

  /// cold_acquisition | event_followup | client_reminder | dormant_revival.
  /// A String rather than an enum, matching `status` above — the vocabulary is the
  /// manual's proposal and is likely to move once it meets the real campaigns.
  purpose       String?
  segment       String?
  serviceLine   String?
  /// Which domain the sequence sends from. The routing rule in §14.3 turns on this.
  sendingDomain String?

  /// Copy signed off, and the statutory figures in it verified. Two separate acts by two
  /// different people, so two sets of columns rather than one flag.
  copyApprovedByEmail    String?
  copyApprovedAt         DateTime?
  numbersVerifiedByEmail String?
  numbersVerifiedAt      DateTime?

  /// A hash of the steps as they stood when each sign-off was given. An approval is only
  /// an approval of what was read: without this, someone approves a template, the copy is
  /// then edited or re-synced from Smartlead, and the tick silently stands over text
  /// nobody has seen. Compared on read; a mismatch reports the approval as stale rather
  /// than valid.
  copyApprovedHash    String?
  numbersVerifiedHash String?

  steps     SequenceStep[]
  prospects Prospect[]


  /// The provider's own id for this row, when a sync imported it. Lets a re-sync update
  /// in place instead of duplicating — the pattern Campaign already uses.
  externalId String?
  source     String? // integration id: smartlead, …

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@map("sequence")
}

model SequenceStep {
  id         String @id @default(cuid())
  sequenceId String
  position   Int

  /// Days to wait after the previous step before this one is due.
  waitDays Int    @default(0)
  channel  String @default("email") // email | linkedin | call
  subject  String?
  body     String

  sequence Sequence          @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  messages OutreachMessage[]

  @@unique([sequenceId, position])
  @@map("sequence_step")
}

model Prospect {
  id         String         @id @default(cuid())
  sequenceId String
  contactId  String?
  email      String
  firstName  String?
  lastName   String?
  companyName String?
  status     ProspectStatus @default(pending)
  currentStep Int           @default(0)

  sequence Sequence          @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact  Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages OutreachMessage[]


  /// The provider's own id for this row, when a sync imported it. Lets a re-sync update
  /// in place instead of duplicating — the pattern Campaign already uses.
  externalId String?
  source     String? // integration id: smartlead, …

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@unique([sequenceId, email])
  @@map("prospect")
}

model OutreachMessage {
  id         String @id @default(cuid())
  prospectId String
  stepId     String

  /// sent | failed | skipped. Written by whichever EmailProvider handled it — the
  /// console provider records "sent" without sending, and says so in `providerId`.
  status     String    @default("sent")
  providerId String?
  sentAt     DateTime  @default(now())
  openedAt   DateTime?
  repliedAt  DateTime?
  error      String?

  prospect Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  step     SequenceStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([prospectId, sentAt])
  @@map("outreach_message")
}

// ─── content ──────────────────────────────────────────────────────────────────

model ContentPiece {
  id     String        @id @default(cuid())
  title  String
  status ContentStatus @default(idea)
  format String        @default("blog") // blog | video | social | email | landing_page | case_study

  authorEmail String?
  channelSlug String?
  campaignId  String?

  brief       String?
  url         String?
  publishDate DateTime?

  views       Int @default(0)
  leadsGenerated Int @default(0)

  tags String[] @default([])

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("content_piece")
}

// ─── AI, notifications, audit ─────────────────────────────────────────────────

/// A generated insight. `provider` records what produced it — "anthropic" for a real
/// call, "seed" for the labelled examples that ship with the demo data. The UI shows
/// that distinction rather than presenting seeds as analysis.
model AiInsight {
  id       String      @id @default(cuid())
  kind     InsightKind
  title    String
  body     String
  provider String      @default("seed")
  model    String?

  /// What the insight is about, for deep-linking: {module:"leads", campaignId:"…"}.
  context Json?

  /// 0-100, from the model. Null when the provider gave none.
  confidence Int?

  dismissedAt DateTime?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("ai_insight")
}

model Notification {
  id        String    @id @default(cuid())
  title     String
  body      String?
  level     String    @default("info") // info | success | warning | error
  href      String?
  forEmail  String?
  readAt    DateTime?

  createdAt DateTime @default(now())

  @@index([forEmail, readAt])
  @@map("notification")
}

/// Who changed what. Same purpose as bng-command-center's AuditEvent: a row per write,
/// so a wrong number has a trail.
model AuditEvent {
  id         String @id @default(cuid())
  actorEmail String
  action     String
  entityType String
  entityId   String?
  detail     Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_event")
}
